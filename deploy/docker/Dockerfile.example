FROM eclipse-temurin:17-jre@sha256:c6f2875c05ea10f16398bdc5f73405c384991506f2f1ead8bcc6582ae8adea79
WORKDIR /app

ARG APP_JAR=dist/app.jar
RUN useradd --system --uid 10001 --create-home agentapp
COPY --chown=10001:10001 ${APP_JAR} /app/app.jar

USER 10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
