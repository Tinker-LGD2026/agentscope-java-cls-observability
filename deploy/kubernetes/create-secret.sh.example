#!/usr/bin/env sh
set -eu

: "${CLS_SECRET_ID:?CLS_SECRET_ID is required}"
: "${CLS_SECRET_KEY:?CLS_SECRET_KEY is required}"

args=""
if [ -n "${CLS_SECRET_TOKEN:-}" ]; then
  args="--from-literal=secret-token=${CLS_SECRET_TOKEN}"
fi

# shellcheck disable=SC2086
kubectl create secret generic cls-credentials \
  --from-literal=secret-id="$CLS_SECRET_ID" \
  --from-literal=secret-key="$CLS_SECRET_KEY" \
  $args \
  --dry-run=client -o yaml | kubectl apply -f -
