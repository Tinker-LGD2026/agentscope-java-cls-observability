CLS_TRANSPORT=cloud
CLS_ENDPOINT=ap-shanghai.cls.tencentyun.com
CLS_TOPIC_ID=<trace-topic-id>
CLS_SECRET_ID=<secret-id>
CLS_SECRET_KEY=<secret-key>
CLS_SERVICE_NAME=my-agent-service
CLS_DEPLOYMENT_ENVIRONMENT=production
CLS_CONTENT_CAPTURE=off
CLS_REASONING_CAPTURE=off
CLS_PROVIDER_PAYLOAD_CAPTURE=off
CLS_REACTOR_CONTEXT_MODE=private
CLS_EXPORT_SCHEDULE_DELAY_MS=2000
CLS_MAX_QUEUE_SIZE=4096
